# Copy to .env and fill in the blanks. .env is never committed.

# --- Application ---
ENVIRONMENT_NAME=development
LOG_LEVEL=INFO

# --- Database ---
# POSTGRES_USER/PASSWORD/DB initialise the Postgres container.
# HOST/PORT tell the application where to find it:
#   db        when running under Docker Compose (the service name)
#   localhost when running the app directly against a published port
POSTGRES_DB=personalsaving
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Public address of the API, as clients reach it.
# No trailing slash.
#   http://localhost:4455      local development
#   https://finance.example.com  behind a reverse proxy
EXTERNAL_BASE_URL=http://localhost:4455
POSTGRES_USER=personalsaving
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
